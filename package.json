{
  "name": "order-service",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rspack build",
    "dev": "cross-env NODE_ENV=development rspack --watch --mode development",
    "start": "node --enable-source-maps dist/main.cjs",
    "fmt": "rs fmt",
    "lint": "rs lint",
    "test": "rs test",
    "db:emit": "prisma contract emit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down --volumes",
    "db:init": "prisma db init",
    "db:plan": "prisma migration plan",
    "db:migrate:dev": "prisma db migrate --advance-ref db",
    "db:migrate:deploy": "prisma db migrate",
    "db:migrate:status": "prisma migration status"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/i18n": "^0.0.1",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/orm-postgres": "8.0.0-rc.18",
    "@rstest/core": "^0.12.3",
    "@scalar/nestjs-api-reference": "^1.2.30",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "prisma": "8.0.0-rc.23",
    "reflect-metadata": "^0.2.2",
    "run-script-webpack-plugin": "0.2.3",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@rspack/cli": "2.2.8",
    "@rspack/core": "2.2.8",
    "@rspack/dev-server": "2.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "cross-env": "10.1.0",
    "dotenv": "^18.0.8",
    "rstack": "^0.8.4",
    "temporal-polyfill": "^1.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "webpack-node-externals": "3.0.0"
  }
}
